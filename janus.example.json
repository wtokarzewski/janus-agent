{
  "llm": {
    "providers": {
      "anthropic": { "auth": "oauth", "priority": 0 },
      "openrouter": { "priority": 1 }
    },
    "slots": {
      "default": {
        "anthropic": "claude-sonnet-5",
        "openrouter": "anthropic/claude-sonnet-5"
      },
      "background": {
        "anthropic": "claude-haiku-4-5-20251001",
        "openrouter": "anthropic/claude-haiku-4-5-20251001"
      }
    },
    "maxTokens": 4096,
    "temperature": 0.7,
    "toolTemperature": 0.3,
    "reasoningEffort": "medium",
    "thinking": {
      "enabled": false,
      "budgetTokens": 10000,
      "level": "medium"
    },
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 2,
      "cooldownMs": 300000
    }
  },

  "agent": {
    "summarizationThreshold": 20,
    "contextWindow": 1000000,
    "toolRetries": 2,
    "onLLMError": "retry",
    "onToolError": "continue",
    "maxSkillsInPrompt": 150,
    "maxSkillsPromptChars": 30000,
    "laneTimeoutMs": 600000,
    "lanes": {
      "user": 6,
      "cron": 3,
      "heartbeat": 2
    },
    "subagents": {
      "maxSpawnDepth": 1,
      "maxChildrenPerAgent": 5,
      "maxConcurrentSubagents": 8
    },
    "context": {
      "keepRecentTokens": 20000,
      "reserveTokens": 20000,
      "toolResultMaxShare": 0.3,
      "toolResultHardMax": 400000,
      "softTrimChars": 4000,
      "compactionThresholds": [0.75, 0.80, 0.85],
      "emergencyThreshold": 0.95,
      "protectedTailTurns": 3
    }
  },

  "workspace": {
    "dir": ".",
    "memoryDir": "memory",
    "sessionsDir": "sessions",
    "skillsDir": "skills"
  },

  "tools": {
    "execEnabled": true,
    "execTimeout": 30000,
    "maxFileSize": 1048576,
    "webSearchApiKey": "BSA...",
    "webFetchTimeoutMs": 10000,
    "webFetchMaxBytes": 51200,
    "execDenyPatterns": [
      "rm\\s+-rf\\s+/",
      "rm\\s+-rf\\s+~",
      "sudo\\s+rm",
      "mkfs",
      ":\\(\\)\\{:|:&\\};:",
      ">\\s*/dev/sda",
      "dd\\s+if=/dev/zero",
      "sqlite3\\s+.*\\.janus/",
      "sqlite3\\s+.*janus\\.db"
    ],
    "execDenyPatternsExtra": []
  },

  "database": {
    "enabled": true,
    "path": ".janus/janus.db"
  },

  "telegram": {
    "enabled": true,
    "token": "123456789:AABBccDDeeFFggHHiiJJkkLLmmNNoo",
    "allowlist": ["123456789"],
    "denyByDefault": true,
    "groupPolicy": "all",
    "initTimeoutMs": 15000
  },

  "whatsapp": {
    "enabled": false,
    "authDir": "~/.janus/whatsapp-auth",
    "allowlist": [],
    "maxMessageLength": 4000
  },

  "voice": {
    "enabled": false,
    "provider": "groq",
    "apiKey": "gsk_...",
    "language": "en",
    "maxDurationSec": 300
  },

  "vision": {
    "enabled": true,
    "maxFileSizeMb": 10
  },

  "tts": {
    "enabled": false,
    "provider": "openai",
    "apiKey": "sk-...",
    "model": "tts-1",
    "voice": "nova"
  },

  "streaming": {
    "enabled": true,
    "telegramThrottleMs": 500
  },

  "logging": {
    "file": {
      "enabled": false,
      "dir": ".janus/logs",
      "retentionDays": 14
    }
  },

  "cron": {
    "cleanup": {
      "enabled": true,
      "intervalDays": 7,
      "time": "00:05",
      "maxAgeDaysOneShot": 7,
      "maxAgeDaysRecurring": 30
    }
  },

  "heartbeat": {
    "enabled": false,
    "checkIntervalMs": 60000,
    "resyncIntervalMs": 60000
  },

  "timezone": "Europe/Warsaw",

  "autoUpdate": {
    "enabled": false,
    "schedule": "0 9 * * 1",
    "restartMode": "respawn"
  },

  "gates": {
    "enabled": true,
    "execPatterns": [
      "rm\\s",
      "git\\s+push",
      "git\\s+reset",
      "npm\\s+publish",
      "docker\\s+rm"
    ]
  },

  "memory": {
    "vectorSearch": false,
    "vectorWeight": 1.0,
    "textWeight": 1.0,
    "recentDays": 3
  },

  "browserOperator": {
    "chromePath": "",
    "profileDir": "",
    "headless": false
  },

  "mcp": {
    "servers": [
      {
        "name": "example-server",
        "command": "npx",
        "args": ["-y", "@example/mcp-server"],
        "env": {
          "API_KEY": ""
        }
      }
    ]
  },

  "users": [
    {
      "id": "alice",
      "name": "Alice",
      "identities": [
        { "channel": "telegram", "channelUserId": "123456789", "channelUsername": "alice" }
      ],
      "tools": {
        "allow": [],
        "deny": []
      },
      "skills": {
        "allow": [],
        "deny": []
      }
    }
  ],

  "family": {
    "id": "family",
    "groupChatIds": []
  },

  "agents": [
    {
      "id": "main",
      "name": "Janus",
      "description": "Main assistant"
    },
    {
      "id": "work",
      "name": "Work",
      "description": "Work context — focused on programming and GitHub",
      "ego": ".janus/agents/work/EGO.md",
      "tools": { "allow": ["exec", "read_file", "write_file", "edit_file", "list_dir", "web_fetch", "web_search", "spawn_agent"] },
      "params": { "temperature": 0.2 },
      "subagents": { "allowAgents": ["*"] }
    },
    {
      "id": "diet",
      "name": "Diet Coach",
      "description": "Nutrition and meal planning assistant",
      "ego": ".janus/agents/diet/EGO.md",
      "tools": { "deny": ["exec", "spawn_agent"] },
      "params": { "temperature": 0.5 },
      "memory": { "shared": false },
      "heartbeat": {
        "isolatedSession": true,
        "activeHours": { "start": "07:00", "end": "22:00", "tz": "Europe/Warsaw" }
      }
    }
  ],

  "bindings": [
    { "agentId": "work", "match": { "channel": "telegram", "chatId": "-100987654" } },
    { "agentId": "diet", "match": { "channel": "telegram", "chatId": "123456", "topicId": 42 } },
    { "agentId": "main", "match": {} }
  ],

  "defaultAgentId": "main",

  "session": {
    "dmScope": "per-channel-peer",
    "identityLinks": {
      "wojtek": ["telegram:123456", "discord:789012"]
    }
  }
}
